# Public hostname served by Traefik.
# Default in stack.yml: noeticsearch.localhost
HOST=noeticsearch.localhost

# Docker socket path. On macOS Docker Desktop use:
# DOCKER_SOCK=/Users/$USER/.docker/run/docker.sock
# Default in stack.yml: /var/run/docker.sock
DOCKER_SOCK=/var/run/docker.sock

# PostgreSQL credentials used by the postgres service and the app.
POSTGRES_USER=noeticsearch
POSTGRES_PASSWORD=noeticsearch
POSTGRES_DB=noeticsearch

# Required: Mistral API key for AI features.
MISTRAL_API_KEY=

# Required: Better Auth secret. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Required: initial admin account credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Optional: Redis URL (used by the app if configured).
REDIS_URL=

# Optional: GitHub OAuth credentials.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: disable Next.js telemetry.
NEXT_TELEMETRY_DISABLED=1
