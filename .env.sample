# Public hostname (legacy self-host / Traefik). Not required for local `compose.yml`.
HOST=noeticsearch.localhost

# Email used by Let's Encrypt ACME (production self-host only).
ACME_EMAIL=admin@example.com

# Docker socket path (production self-host only).
DOCKER_SOCK=/var/run/docker.sock

# PostgreSQL credentials (local compose + app).
POSTGRES_USER=noeticsearch
POSTGRES_PASSWORD=noeticsearch
POSTGRES_DB=noeticsearch

# Local app DB URLs when using `docker compose up -d` (postgres + redis only):
DATABASE_URL=postgres://noeticsearch:noeticsearch@127.0.0.1:5432/noeticsearch
WORKFLOW_POSTGRES_URL=postgres://noeticsearch:noeticsearch@127.0.0.1:5432/noeticsearch
REDIS_URL=redis://127.0.0.1:6379

# Required: Mistral API key for AI features.
MISTRAL_API_KEY=

# Required: Better Auth secret. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Required: initial admin account credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Optional: disable Next.js telemetry.
NEXT_TELEMETRY_DISABLED=1
